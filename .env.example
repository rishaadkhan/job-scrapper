# ─── Job Scraper Enterprise — Environment Variables ───────────────────────────
# Copy to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, development): leave as-is
DATABASE_URL=sqlite+aiosqlite:///jobscraper.db
# PostgreSQL (production / Fly.io): uncomment and set
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/jobscraper

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Admin Credentials (first-boot bootstrap) ─────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ── LLM / Resume ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LLM_SUGGESTION_THRESHOLD=60
RESUME_FILE=resume.md

# ── Storage & Retention ───────────────────────────────────────────────────────
OUTPUT_DIR=output
RETENTION_DAYS=14

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry: obtain DSN from https://sentry.io → Project Settings → Client Keys
# Leave blank to disable Sentry entirely.
SENTRY_DSN=

# Deployment environment tag ("production", "staging", "local")
ENVIRONMENT=production

# Heartbeat: paste your https://healthchecks.io ping URL here.
# Leave blank to disable heartbeat monitoring.
HEARTBEAT_URL=

# ── Daily Digest — Telegram (primary) ────────────────────────────────────────
# Create a bot via @BotFather, then get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minimum match score to include in digest (0–100)
DIGEST_SCORE_THRESHOLD=60
# Maximum number of jobs to list in each digest message
DIGEST_TOP_N=10

# ── Daily Digest — SMTP email (fallback if Telegram not configured) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# ── CORS (comma-separated allowed origins for the API) ────────────────────────
# In production, replace with your actual frontend domain:
# CORS_ORIGINS=https://jobscraper.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
