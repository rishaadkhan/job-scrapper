# ─────────────────────────────────────────────────────────────────────────────
# Enterprise Job Scraper & Resume Intelligence Engine — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.
#
# Variables below are classified into:
#   [REQUIRED]  — The application cannot start without these. Missing vars fail fast.
#   [OPTIONAL]  — Features gracefully degrade / disable if absent. Core pipeline runs.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# 1. [REQUIRED] CORE STORAGE & SECURITY
# =============================================================================

# [REQUIRED] Database Connection URL
# SQLite (development / local default):
DATABASE_URL=sqlite+aiosqlite:///jobscraper.db
# PostgreSQL (production / multi-tenant / Fly.io):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobscraper
# Behavior if missing: Application FAILS FAST at startup with a critical configuration error.

# [REQUIRED] JWT Secret Key
# Used for cryptographically signing authentication tokens for the FastAPI backend and dashboard.
# Generate a secure random key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=super-secret-jobscraper-key-change-in-production
# Behavior if missing: Application FAILS FAST at startup to prevent running with insecure auth.

# JWT Algorithm & Expiration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Bootstrap Credentials (Used during database migration)
ADMIN_EMAIL=admin@jobscraper.io
ADMIN_PASSWORD=admin123


# =============================================================================
# 2. [OPTIONAL] RESUME INTELLIGENCE & OPENROUTER LLM BULLET GENERATION
# =============================================================================

# OpenRouter API Key
# Required only if AI resume bullet tailoring feature is to be enabled.
# Behavior if absent / empty: Application logs "Resume tailoring: DISABLED" at startup
# and every downstream call site cleanly no-ops without raising.
OPENROUTER_API_KEY=

# OpenRouter Model Priority (Ordered Fallback Sequence)
# Comma-separated list of OpenRouter model slugs to attempt in sequence.
# If primary model hits 429 rate limit or 5xx error, automatically falls back to next slug.
OPENROUTER_MODEL_PRIORITY=anthropic/claude-3.5-sonnet,openai/gpt-4o-mini,meta-llama/llama-3.1-8b-instruct

# Minimum Match Score (0–100) to Trigger LLM Bullet Generation
# Roles scoring below this threshold skip LLM calls to save tokens.
LLM_SUGGESTION_THRESHOLD=60

# Candidate Resume Source File (Legacy Markdown)
RESUME_FILE=resume.md

# Legacy Anthropic API Key (Optional fallback if OpenRouter is unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest


# =============================================================================
# 3. [OPTIONAL] LATEX COMPILER & CLOUDFLARE R2 OBJECT STORAGE
# =============================================================================

# Sandboxed Tectonic LaTeX Compiler Microservice URL
# Internal service address (never exposed outside private network).
# Local dev / Compose: http://localhost:8001 or http://latex-compiler:8001
# Railway private networking: http://latex-compiler.railway.internal:8001
LATEX_COMPILER_URL=http://localhost:8001

# Cloudflare R2 (S3-Compatible) Storage Credentials
# Used to persist and serve compiled PDF resumes.
# Behavior if unset / incomplete: A clear warning is logged and PDF storage in
# object storage is cleanly disabled without crashing the application.
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# R2 S3 Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional public custom domain or CDN URL (e.g. https://resumes.yourdomain.com)
R2_PUBLIC_URL=



# =============================================================================
# 3. [OPTIONAL] OBSERVABILITY & HEALTH MONITORING
# =============================================================================

# Sentry DSN (Error & Performance Monitoring)
# Obtain from: https://sentry.io → Project Settings → Client Keys (DSN)
# Behavior if absent / empty: Sentry integration is completely disabled (no-op).
SENTRY_DSN=

# Environment tag sent to Sentry ('production', 'staging', 'local')
ENVIRONMENT=production

# Healthchecks.io Heartbeat Ping URL
# Ping URL called at the end of each successful automated scrape run.
# Example: https://hc-ping.com/12345678-1234-1234-1234-123456789abc
# Behavior if absent / empty: Heartbeat ping is silently skipped.
HEARTBEAT_URL=


# =============================================================================
# 4. [OPTIONAL] DAILY DIGEST NOTIFICATIONS
# =============================================================================

# ── Primary Channel: Telegram Bot ────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, then get your numeric chat ID via @userinfobot.
# Behavior if absent / empty: Telegram notification is skipped; falls back to SMTP if configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minimum match score to qualify a job for the daily digest message (0–100)
DIGEST_SCORE_THRESHOLD=60

# Maximum number of top leads to display in the digest message
DIGEST_TOP_N=10

# ── Fallback Channel: SMTP Email ─────────────────────────────────────────────
# Sent only if Telegram is not configured or if Telegram delivery fails.
# Behavior if absent / empty: Email dispatch is skipped; no notification error is raised.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=


# =============================================================================
# 5. [OPTIONAL] WEB DASHBOARD & CORS CONFIGURATION
# =============================================================================

# Comma-separated list of allowed origins for the FastAPI backend CORS middleware.
# In production, set to your frontend domain (e.g. https://dashboard.yourdomain.com)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Directory where generated Excel files are written
OUTPUT_DIR=output

# Number of days to retain scrape runs and lead exports before automated cleanup
RETENTION_DAYS=14
